{
  "name": "machora",
  "version": "0.1.0",
  "private": true,
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "standalone:dev": "pnpm --filter @machora/standalone dev",
    "standalone:start": "pnpm --filter @machora/standalone start"
  },
  "devDependencies": {
    "turbo": "^2.10.7",
    "typescript": "^5.6.0"
  }
}
