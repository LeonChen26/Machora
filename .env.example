# Machora Standalone 配置
#
# 鉴权默认开启（NODE_ENV=production）：
# - 管理界面登录（NextAuth）：NEXTAUTH_SECRET 未配置时启动随机生成，重启后登录会话失效，
#   生产请务必显式配置固定值
# - 开放 API（verifyApiKey）：MACHORA_INIT_PROJECT_PUBLIC_KEY / SECRET_KEY 未配置时
#   seed 跳过创建，不注入公开的 dev 种子值；生产请显式配置唯一密钥（不沿用示例值）
DATA_DIR=./.machora-data
PG_PORT=5434
PORT=3100
NODE_ENV=production

# Seed 凭据（首次启动自动创建；生产环境必须替换为唯一随机值）
MACHORA_INIT_PROJECT_NAME=Machora Project
# 生成唯一密钥示例：openssl rand -hex 16
MACHORA_INIT_PROJECT_PUBLIC_KEY=pk-REPLACE-WITH-UNIQUE-KEY
MACHORA_INIT_PROJECT_SECRET_KEY=sk-REPLACE-WITH-UNIQUE-KEY
MACHORA_INIT_USER_EMAIL=admin@machora.local
# 管理员初始密码（示例值，部署前请务必修改；不设置时首次启动随机生成并打印在日志）
MACHORA_INIT_USER_PASSWORD=change-me-please
MACHORA_INIT_USER_NAME=Admin

NEXTAUTH_URL=http://localhost:3100
# 生产必须配置固定值（生成：openssl rand -base64 32）；留空则启动随机生成，重启后登录会话失效
NEXTAUTH_SECRET=

# Web UI 登录 session 签名密钥（不设置时自动持久化到 DATA_DIR/session-secret）
MACHORA_SESSION_SECRET=
