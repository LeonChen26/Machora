{
  "name": "@machora/standalone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/start.js",
  "scripts": {
    "dev": "tsx src/start.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "cross-env NODE_ENV=production node dist/start.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.4",
    "@electric-sql/pglite-socket": "^0.2.7",
    "@machora/shared": "workspace:*",
    "@machora/worker": "workspace:*",
    "bcryptjs": "^2.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0"
  }
}
