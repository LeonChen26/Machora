// Machora Prisma schema — 单一真源
// 参考 Langfuse packages/shared/prisma/schema.prisma 宽事件设计

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// 元数据
// ---------------------------------------------------------------------------

model Project {
  id            String        @id @default(cuid())
  name          String
  createdAt     DateTime      @default(now())
  apiKeys       ApiKey[]
  traces        Trace[]
  metricSamples MetricSample[]
}

model ApiKey {
  id           String   @id @default(cuid())
  projectId    String
  publicKey    String   @unique
  hashedSecret String
  name         String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// 核心观测数据（宽事件模型）
// ---------------------------------------------------------------------------

model Trace {
  id          String   @id // OTel traceId（hex）
  projectId   String
  name        String?
  timestamp   DateTime
  environment String   @default("default")
  userId      String?
  sessionId   String?
  agentName   String?
  workflowName String?
  skillName   String?
  input       Json?
  output      Json?
  metadata    Json?
  tags        String[]
  createdAt   DateTime @default(now())
  project     Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  observations Observation[]
  scores      Score[]
  evaluations Evaluation[]

  @@index([projectId, timestamp])
  @@index([userId])
  @@index([sessionId])
}

model Observation {
  id                 String    @id // OTel spanId（hex）
  traceId            String
  projectId          String
  type               String // SPAN | GENERATION | EVENT
  name               String?
  parentObservationId String? // OTel parentSpanId → 本批内父 observation
  startTime          DateTime
  endTime            DateTime?
  model              String?
  agentName          String?
  workflowName       String?
  skillName          String?
  input              Json?
  output             Json?
  metadata           Json?
  level              String    @default("DEFAULT") // DEBUG | DEFAULT | WARNING | ERROR
  // Token / 成本统计（服务端根据 usage 推算并写入）
  usage              Json?
  inputTokens        Int?
  outputTokens       Int?
  totalTokens        Int?
  totalCost          Float?
  trace              Trace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([projectId, startTime])
  @@index([traceId])
  @@index([parentObservationId])
}

model Score {
  id            String   @id @default(cuid())
  traceId       String?
  observationId String?
  projectId     String
  name          String
  value         Float
  dataType      String // NUMERIC | CATEGORICAL | BOOLEAN
  source        String // API | ANNOTATION | EVALUATION
  comment       String?
  timestamp     DateTime @default(now())
  trace         Trace? @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([projectId, timestamp])
  @@index([traceId])
}

// ---------------------------------------------------------------------------
// 服务端评估任务（Phase 3）
// ---------------------------------------------------------------------------

model Evaluation {
  id            String   @id @default(cuid())
  projectId     String
  traceId       String
  name          String // 写回 Score 时的 name
  evaluatorType String // 内置规则类型；预留 "llm" 等扩展
  config        Json? // 评估器配置（阈值等）
  status        String   @default("PENDING") // PENDING | RUNNING | COMPLETED | ERROR
  error         String?
  result        Json? // 评估结果摘要（EvaluationResult）
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  trace         Trace @relation(fields: [traceId], references: [id], onDelete: Cascade)

  @@index([projectId, createdAt])
  @@index([traceId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// 指标采样（OTLP metrics 外部接入 + 自观测共用）
// ---------------------------------------------------------------------------

model MetricSample {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  unit       String?
  kind       String // GAUGE | SUM | HISTOGRAM
  attributes Json? // labels（OTLP attributes / 自观测维度）
  timestamp  DateTime
  // gauge / sum：单值
  value      Float?
  // histogram：摘要
  count      Float?
  sum        Float?
  min        Float?
  max        Float?
  buckets    Json? // [{ boundary: number, count: number }]（累计直方图）
  createdAt  DateTime @default(now())
  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, name, timestamp])
  @@index([name, timestamp])
}
