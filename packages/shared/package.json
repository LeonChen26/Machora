{
  "name": "@machora/shared",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./db": "./src/db.ts",
    "./env": "./src/env.ts",
    "./server": "./src/server/index.ts"
  },
  "scripts": {
    "dev": "tsc --watch --noEmit",
    "build": "tsc --noEmit",
    "lint": "echo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma db push --accept-data-loss --skip-generate"
  },
  "turbo": {
    "build": {
      "outputs": []
    }
  },
  "dependencies": {
    "@prisma/client": "^5.20.0",
    "bcryptjs": "^2.4.3",
    "protobufjs": "^8.7.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "prisma": "^5.20.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.10"
  }
}
